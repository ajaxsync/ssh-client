{
  "name": "ssh-client-plus",
  "version": "1.0.3",
  "description": "Personal SSH & SFTP client built with Electron",
  "main": "./out/main/index.js",
  "author": "ajaxsync",
  "homepage": "https://github.com/ajaxsync/ssh-client",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "postinstall": "node -e \"console.log('skip native rebuild')\"",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "pinia": "^3.0.3",
    "ssh2": "^1.16.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
